# Leave Supabase vars empty to run in demo mode (localStorage + BroadcastChannel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 1 forces demo mode even when Supabase vars exist
NEXT_PUBLIC_FORCE_DEMO=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 0 disables demo bots
NEXT_PUBLIC_DEMO_BOTS=1
# server only
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_KEY=
